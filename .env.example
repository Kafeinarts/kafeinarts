# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.
# Vue CLI memakai prefix VUE_APP_* (VITE_* untuk kompatibilitas Vite).

VUE_APP_GITHUB_OWNER=Kafeinarts
VUE_APP_GITHUB_REPO=kafeinarts
VUE_APP_GITHUB_BRANCH=main
VUE_APP_GITHUB_TOKEN=

VITE_GITHUB_OWNER=Kafeinarts
VITE_GITHUB_REPO=kafeinarts
VITE_GITHUB_BRANCH=main
VITE_GITHUB_TOKEN=

# github | local
VUE_APP_CMS_SOURCE=github
VITE_CMS_SOURCE=github
